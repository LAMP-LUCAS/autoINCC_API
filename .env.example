# ==============================================================================
# AutoINCC API - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development
APP_NAME=AutoINCC API
APP_VERSION=0.1.0
DEBUG=True

# API Server Host & Port
HOST=0.0.0.0
PORT=8000

# Security - API Key for protected endpoints (like /api/v1/etl/trigger)
API_KEY=autoincc_secret_token_dev_123

# Database Connection (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/autoincc

# Redis (Celery Broker & API Cache)
REDIS_URL=redis://localhost:6379/0

# Cache Configuration
CACHE_ENABLED=True
CACHE_TTL_SECONDS=3600

# Polite Request Pacing & Jitter (ETL Rate Limiting)
ETL_REQUEST_DELAY_BASE=1.5
ETL_REQUEST_DELAY_JITTER=1.5
ETL_POLITE_PACING_ENABLED=True

# BCB SGS API Base URL
BCB_API_URL=https://api.bcb.gov.br/dados/serie/bcdata.sgs

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
